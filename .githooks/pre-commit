#!/bin/bash

[[ "$(hostnamectl hostname)" == "tude" ]] || exit 0

gitroot="$(git rev-parse --show-toplevel)"
etcdir="$gitroot/etc"
mkdir -p "$etcdir"

systemctl list-unit-files --state=enabled --no-legend | awk '{print $1}' > "$etcdir/systemd-system"
systemctl list-unit-files --user --state=enabled --no-legend | awk '{print $1}' > "$etcdir/systemd-user"
