### Modifiers 
# Mod1 for Alt 
set $mod Mod4
# Home row direction keys
set $left h
set $down j
set $up k
set $right l

### Apps
# Terminal emulator
set $term alacritty
# Application launcher
set $menu tofi-drun --drun-launch=true

# Make these apps float by default
for_window [app_id="^firefox$|^librewolf$" title="^Picture-in-Picture$"] floating enable
for_window [app_id="^firefox$|^librewolf$" title="Bitwarden"] floating enable
for_window [app_id="^firefox$|^librewolf$" title="Library"] floating enable
for_window [app_id="^Alacritty$" title="File chooser"] floating enable, resize set width 1200 height 900

### Local scripts
set $scripts ~/.local/bin

### Gaps
gaps inner 10
gaps outer 5

### Borders
default_border pixel 1

### Output configuration
set $laptop "eDP-1"
# Wallpaper
output * bg ~/.local/share/backgrounds/bg fill #5c5c5c
# Laptop screen
output $laptop resolution 1920x1200 position 0 0 scale 1

### Lid behavior
# Turn on laptop screen when lid opens
bindswitch --reload --locked lid:off output $laptop enable
# Turn off laptop screen or go to sleep when lid closes
bindswitch --reload --locked lid:on exec $scripts/lid-on

### Idle configuration
# Swayidle config - repeated `systemctl sleep` timeouts are useful in the 
# event that earlier timeouts are missed because of an inhibitor (e.g. backup job) 
exec swayidle -w -d \
         timeout 25 'if pgrep swaylock; then systemctl sleep; fi' \
         timeout 290 'dunstify -r 9999 "Idle" "Going to sleep due to inactivity"' \
             resume 'dunstctl close 9999' \
         timeout 300 'playerctl -a pause; swaylock -f -c 000000' \
         timeout 310 'systemctl sleep' \
         timeout 900 'systemctl sleep' \
         timeout 7200 'systemctl sleep'

### Input configuration
# Touchpad
input type:touchpad {
    tap disabld
    click_method clickfinger
    dwt enabled
    natural_scroll enabled
    middle_emulation enabled
  }
# Keyboard
input type:keyboard {
      repeat_delay 300
      repeat_rate 40
      xkb_layout "eu","es"
      xkb_options caps:swapescape,grp:alt_shift_toggle
      xkb_capslock disabled
      xkb_numlock enabled
  }

### Key bindings
# Start a terminal
bindsym $mod+Return exec $term
# Kill focused window
bindsym $mod+Shift+q kill
# Start your launcher
bindsym $mod+d exec $menu
# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal
# Reload the configuration file
bindsym --locked $mod+Shift+c reload
# Clear all notifications
bindsym $mod+Shift+n exec dunstctl close-all

### Special modes
# Swaynag mode
# Shortcut
set $nag exec swaynagmode
mode "nag" {
  bindsym {
    Ctrl+d    mode "default"
    Ctrl+c    $nag --exit
    q         $nag --exit
    Escape    $nag --exit
    Return    $nag --confirm
    Tab       $nag --select prev
    Shift+Tab $nag --select next
    Left      $nag --select next
    Right     $nag --select prev
    Up        $nag --select next
    Down      $nag --select prev
  }
}
# Exit sway
bindsym $mod+Shift+e exec $nag -t warning -R -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit' -s 'Quit'
# Restart / Shut down
bindsym $mod+Shift+p exec $nag -t warning -m 'Wanna go?' -B 'Shut down' 'systemctl poweroff' -B 'Restart' 'systemctl reboot' -s 'Quit' -R

# Resize
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Advanced screenshots
mode "special" {
    # Color picker
    bindsym c exec $scripts/screenshot colorpicker; mode "default"
    # Copy selection to clipboard
    bindsym s exec $scripts/screenshot selection-copy; mode "default"
    # Copy screen to clipboard
    bindsym Shift+s exec $scripts/screenshot screen-copy; mode "default"
    # Save selection to screenshots dir
    bindsym a exec $scripts/screenshot selection; mode "default"
    # Cancel mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# Keybinding special mode
bindsym $mod+z mode "special"

### Special keybindings
# Lock the screen
bindsym $mod+Shift+z exec 'playerctl -a pause; swaylock -f -c 000000'
# Screenshot full screen
bindsym Print exec $scripts/screenshot screen

### Moving around
# Move your focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
# Or use $mod+[up|down|left|right]
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
# Ditto, with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces:
# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
# Note: workspaces can have any name you want, not just numbers.
# We just use 1-10 as the default.

### Layout 
# You can "split" the current object of your focus with
# $mod+b or $mod+v, for horizontal and vertical splits
# respectively.
bindsym $mod+b splith
bindsym $mod+v splitv
# Switch the current container between different layout styles
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
# Make the current focus fullscreen
bindsym $mod+f fullscreen
# Toggle the current focus between tiling and floating mode
bindsym $mod+Shift+space floating toggle
# Swap focus between the tiling area and the floating area
bindsym $mod+space focus mode_toggle
# Move focus to the parent container
bindsym $mod+a focus parent

### Scratchpad:
# Sway has a "scratchpad", which is a bag of holding for windows.
# You can send windows there and get them back later.
# Move the currently focused window to the scratchpad
bindsym $mod+Shift+minus move scratchpad
# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym $mod+minus scratchpad show

### Media 
# Special keys to adjust audio volume (via PipeWire)
bindsym --locked XF86AudioMute exec $scripts/volumectl mute
bindsym --locked XF86AudioLowerVolume exec $scripts/volumectl down
bindsym --locked XF86AudioRaiseVolume exec $scripts/volumectl up
# Special keys to adjust microphone volume (via PipeWire)
bindsym --locked Shift+XF86AudioLowerVolume exec $scripts/micctl down
bindsym --locked Shift+XF86AudioRaiseVolume exec $scripts/micctl up
bindsym --locked XF86AudioMicMute exec $scripts/micctl mute
# Special keys to adjust brightness (via brightnessctl)
bindsym --locked XF86MonBrightnessDown exec $scripts/iluminacion down
bindsym --locked XF86MonBrightnessUp exec $scripts/iluminacion up
# Keys to manage media playing (via playerctl)
bindsym --locked Shift+F9 exec $scripts/playpause
bindsym --locked XF86AudioPlay exec $scripts/playpause
bindsym --locked XF86AudioPrev exec 'playerctl -s next'
bindsym --locked XF86AudioNext exec 'playerctl -s previous'

### Status Bar:
# Read `man 5 sway-bar` for more information about this section.
font pango:JetBrains Mono Nerd Font 12
bar {
    position top
    font pango:JetBrains Mono Nerd Font 12
    # When the status_command prints a new line to stdout, swaybar updates.
    status_command 'while ~/.config/sway/bar; do sleep 3; done'
    colors {
        statusline #ffffff
        background #323232
        inactive_workspace #323232ff #323232ff #5c5c5c
    }
}

### Startup scripts
exec_always $scripts/sway_clamshell

### Startup apps
exec 'sleep 5 && while ~/.local/bin/battery-check >/dev/null; do sleep 60; done'
exec sway-audio-idle-inhibit
exec --no-startup-id gammastep
exec --no-startup-id wl-paste --watch cliphist store
exec --no-startup-id 'sleep 20 && /usr/local/bin/OS-backup-notify'


### Extras
include /etc/sway/config.d/*
