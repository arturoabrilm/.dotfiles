#!/bin/bash
set -euo pipefail

bluez=org.bluez
notify=(dunstify -a bluetooth -h string:x-dunst-stack-tag:bluetooth_tag)

# Use the first adapter, like bluetoothctl's default controller.
rows=$(busctl --json=short call "$bluez" / org.freedesktop.DBus.ObjectManager GetManagedObjects |
    jq -r '
        .data[0] | to_entries
        | (first(.[] | select(.value["org.bluez.Adapter1"]) | .key) // "") as $adapter
        | [ .[] | .key as $path | .value["org.bluez.Device1"] // empty
            | select(.Adapter.data == $adapter and (.Connected.data or .Trusted.data))
            | {path: $path, address: .Address.data, connected: .Connected.data,
               label: (.Alias.data // .Address.data)} ]
        | sort_by(.address)[]
        | [.path, .connected, .label] | @tsv')

[[ -n $rows ]] || exit 0
declare -A devices=()
menu=()
while IFS= read -r row; do
    IFS=$'\t' read -r path connected label <<< "$row"
    entry="$((${#menu[@]} + 1)): $label"
    [[ $connected != true ]] || entry+=" (c)"
    menu+=("$entry")
    devices[$entry]=$row
done <<< "$rows"

choice=$(printf '%s\n' "${menu[@]}" | tofi) || exit 0
[[ -n $choice && -n ${devices[$choice]:-} ]] || exit 0
IFS=$'\t' read -r path connected label <<< "${devices[$choice]}"
if [[ $connected == true ]]; then
    action=disconnect
else
    action=connect
fi

if busctl call "$bluez" "$path" "$bluez.Device1" "${action^}" > /dev/null; then
    "${notify[@]}" -i bluetooth-active -u normal "Bluetooth" "$label <b>${action}ed</b> ✓"
else
    "${notify[@]}" -u critical "Bluetooth" "Couldn't $action $label "
fi
